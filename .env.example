# Copia este archivo a .env y rellena los valores. .env NUNCA se sube al repositorio.

# Base de datos (desarrollo local con compose.yaml)
DB_URL=jdbc:postgresql://localhost:5432/moneytracker
DB_USER=moneytracker
DB_PASSWORD=

# Clave para firmar los access tokens: mínimo 32 bytes (p. ej. `openssl rand -base64 48`).
# En el perfil dev, si se deja vacía, se genera una clave efímera.
JWT_SECRET=

# Perfil de Spring: dev en local
SPRING_PROFILES_ACTIVE=dev

# Documentación OpenAPI/Swagger (desactivada por defecto; el perfil dev la activa)
API_DOCS_ENABLED=false
